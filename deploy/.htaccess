# Civic Tobacco Machinery — Apache / LiteSpeed config for the static export.
# Upload this file to the ROOT of your Hostinger site (public_html/.htaccess),
# alongside the exported files. It reproduces the redirects + security headers
# that the Node server would normally provide.

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Canonical host: force HTTPS and drop www.
  # Any http:// or https://www. request 301s to https://civic-tobacco-machinery.com
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://civic-tobacco-machinery.com%{REQUEST_URI} [R=301,L]

  # Hide index.html: redirect any request that exposes it to the clean URL
  RewriteCond %{THE_REQUEST} \s/+(.+/)?index\.html[\s?] [NC]
  RewriteRule ^(.*/)?index\.html$ /$1 [R=301,L]

  # ---- 301 redirects: old URLs -> new clean URLs ----

  # Blog: old "karachi" slugs -> "pakistan" slugs
  RewriteRule ^blog/how-to-choose-cigarette-packing-machine-karachi/?$ /blog/how-to-choose-cigarette-packing-machine-pakistan/ [R=301,L]
  RewriteRule ^blog/buying-used-tobacco-machinery-karachi-checklist/?$ /blog/buying-used-tobacco-machinery-pakistan-checklist/ [R=301,L]
  RewriteRule ^blog/hauni-mark-8-vs-mark-9-cigarette-makers/?$ /blog/molins-mark-8-vs-mark-9-cigarette-makers/ [R=301,L]
  RewriteRule ^cigarette-filter-making-machines/hauni-kdf-1/?$ /cigarette-filter-making-machines/kdf-1/ [R=301,L]
  RewriteRule ^cigarette-filter-making-machines/hauni-kdf-2/?$ /cigarette-filter-making-machines/kdf-2/ [R=301,L]
  RewriteRule ^cigarette-making-machines/mark-9-5-max-s/?$ /cigarette-making-machines/mark-9-5-max-s-tray-filler/ [R=301,L]
  RewriteRule ^tobacco-machinery/used-packing-machines/?$ /cigarette-packing-machines/ [R=301,L]
  RewriteRule ^manufacturing-machines/?$ /cigarette-manufacturing-machines/ [R=301,L]
  RewriteRule ^cigarette-making-machines/?$ /cigarette-manufacturing-machines/ [R=301,L]
  RewriteRule ^cigarette-making-machines/(.+?)/?$ /cigarette-manufacturing-machines/$1/ [R=301,L]
  RewriteRule ^cigarette-filter-making-machines/protos-70-filter/?$ /cigarette-filter-making-machines/ [R=301,L]
  RewriteRule ^cigarette-filter-making-machines/protos-80-er-filter/?$ /cigarette-filter-making-machines/ [R=301,L]

  # SASIB slug typo fix (ssasib -> sasib)
  RewriteRule ^cigarette-packing-machines/ssasib-3000/?$ /cigarette-packing-machines/sasib-3000/ [R=301,L]
  RewriteRule ^cigarette-packing-machines/ssasib-5000/?$ /cigarette-packing-machines/sasib-5000/ [R=301,L]

  # Packing / wrapping category slugs
  RewriteRule ^packing-machines/?$ /cigarette-packing-machines/ [R=301,L]
  RewriteRule ^packing-machines/(.+?)/?$ /cigarette-packing-machines/$1/ [R=301,L]
  RewriteRule ^wrapping-machines/?$ /cigarette-box-wrapping-machines/ [R=301,L]
  RewriteRule ^wrapping-machines/(.+?)/?$ /cigarette-box-wrapping-machines/$1/ [R=301,L]

  # Manufacturing sub-categories flattened to root
  RewriteRule ^manufacturing-machines/cigarette-making-machines/?$ /cigarette-making-machines/ [R=301,L]
  RewriteRule ^manufacturing-machines/cigarette-making-machines/(.+?)/?$ /cigarette-making-machines/$1/ [R=301,L]
  RewriteRule ^manufacturing-machines/cigarette-filter-making-machines/?$ /cigarette-filter-making-machines/ [R=301,L]
  RewriteRule ^manufacturing-machines/cigarette-filter-making-machines/(.+?)/?$ /cigarette-filter-making-machines/$1/ [R=301,L]
  RewriteRule ^manufacturing-machines/tobacco-machinery/?$ /cutter-feeder-reclaimer/ [R=301,L]
  RewriteRule ^manufacturing-machines/tobacco-machinery/(.+?)/?$ /cutter-feeder-reclaimer/$1/ [R=301,L]

  # Category renamed: tobacco-machinery -> cutter-feeder-reclaimer.
  # (The specific /tobacco-machinery/used-packing-machines rule above wins first.)
  RewriteRule ^tobacco-machinery/?$ /cutter-feeder-reclaimer/ [R=301,L]
  RewriteRule ^tobacco-machinery/(.+?)/?$ /cutter-feeder-reclaimer/$1/ [R=301,L]

  # Retired "used" pages -> relevant machine sections
  RewriteRule ^used-machinery(/.*)?$ /cigarette-manufacturing-machines/ [R=301,L]
  RewriteRule ^used-manufacturing-machines/?$ /cigarette-manufacturing-machines/ [R=301,L]
  RewriteRule ^used-cigarette-filter-machinery/?$ /cigarette-filter-making-machines/ [R=301,L]
  RewriteRule ^used-packing-machines/?$ /cigarette-packing-machines/ [R=301,L]
  RewriteRule ^used-wrapping-machines/?$ /cigarette-box-wrapping-machines/ [R=301,L]
  RewriteRule ^used-tobacco-machinery/?$ /cutter-feeder-reclaimer/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
